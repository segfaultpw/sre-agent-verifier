# Environment given to every command, on top of the runner's fixed set.
# Install scripts are off by default: the spec disables them where the package
# manager has the option. A repository whose tests need a native build turns them
# on in its own setup command.
npm_config_ignore_scripts=true
YARN_ENABLE_SCRIPTS=false
npm_config_update_notifier=false
npm_config_fund=false
npm_config_audit=false
NODE_ENV=test
